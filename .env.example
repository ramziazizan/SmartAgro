# ========================================================
# SMART AGRO DEV - TEMPLATE ENVIRONMENT TUNGGAL (.env.example)
# Salin file ini menjadi .env lalu isi nilainya
# ========================================================

# --------------------------------------------------------
# 1. FRONTEND CONFIGURATION (VITE)
# --------------------------------------------------------
# URL Base Backend API:
# - Lokal: http://localhost:3001
# - Vercel (monorepo 1 project): kosongkan agar menggunakan internal rewrite /api
# - Production terpisah: URL backend Vercel (contoh: https://smart-agro-api.vercel.app)
VITE_API_BASE_URL=

# Sumber Data Sensor (Google Sheets CSV export)
VITE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/10P_5T0kOlcCjmxXzyBLU8qr76NiOYcmliPZwH7rehg8/export?format=csv

# Sumber Data Cuaca (Open-Meteo Forecast)
VITE_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast?latitude=3.5952&longitude=98.6722&current=weather_code&hourly=weather_code,precipitation_probability&forecast_days=1&timezone=Asia%2FBangkok

# --------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION
# --------------------------------------------------------
PORT=3001
FRONTEND_ORIGINS=http://localhost:5173,https://ramziazizan.github.io

# --------------------------------------------------------
# 3. MQTT BROKER CONFIGURATION
# --------------------------------------------------------
MQTT_BROKER_URL=mqtts://your-cluster.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-agro-backend
MQTT_TOPIC_PREFIX=smartagro
MQTT_DEVICE_ID=esp32-01

# --------------------------------------------------------
# 4. DASHBOARD AUTHENTICATION (LOGIN GRAFIK SENSOR)
# --------------------------------------------------------
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Kunci Enkripsi Token API (Minimal 32 Karakter acak)
AUTH_TOKEN_SECRET=
