PORT=3001
FRONTEND_ORIGINS=http://localhost:5173,https://ramziazizan.github.io

# Create separate credentials for the backend and ESP32 in the broker.
MQTT_BROKER_URL=mqtts://your-cluster.example.com:8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=smart-agro-backend
MQTT_TOPIC_PREFIX=smartagro
MQTT_DEVICE_ID=esp32-01

# Dashboard login; use a unique username and a strong password.
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=

# Generate a random secret of at least 32 characters for signing short-lived API tokens.
AUTH_TOKEN_SECRET=
