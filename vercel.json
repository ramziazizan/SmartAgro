{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "smart-agro-dashboard": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build",
      "outputDirectory": "dist"
    },
    "smart-agro-api": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/vercel.js",
      "installCommand": "npm ci"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "smart-agro-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "smart-agro-dashboard"
      }
    }
  ]
}
